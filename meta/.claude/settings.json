{
  "permissions": {
    "additionalDirectories": [
      "../prodev",
      "../crew",
      "../knowledge",
      "../minidiscord"
    ],
    "deny": [
      "Edit(/../prodev/**)",
      "Edit(/../crew/**)",
      "Edit(/../minidiscord/**)",
      "Edit(/../knowledge/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\"", "timeout": 10 }
        ]
      }
    ]
  }
}
